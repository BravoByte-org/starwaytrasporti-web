# BravoByte private packages — GitHub Packages for @bravobyte-org.
# The token comes from GH_BRAVOBYTE_PACKAGE, which must be in pnpm's environment:
# locally run `infisical run -- pnpm install`; in CI the job token is mapped to it.
# CI: https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-npm-registry
@bravobyte-org:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GH_BRAVOBYTE_PACKAGE}
engine-strict=true
